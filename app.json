{
  "expo": {
    "name": "StormReady",
    "slug": "stormready",
    "scheme": "stormready",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "runtimeVersion": "1.1.0",
    "updates": {
      "url": "https://u.expo.dev/da0fc52f-5fc0-453d-94dc-90c1888bbdec",
      "checkAutomatically": "ON_LOAD"
    },
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Use your location to find nearby shelters and check local weather alerts. Location stays on this device."
        }
      ]
    ],
    "android": {
      "package": "org.stormready.app",
      "adaptiveIcon": {
        "backgroundColor": "#F3F7F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "da0fc52f-5fc0-453d-94dc-90c1888bbdec"
      }
    }
  }
}
